# Text with LF line endings everywhere, so sources hash the same on every machine.
* text=auto eol=lf

*.py    text eol=lf diff=python
*.c     text eol=lf
*.h     text eol=lf
*.s     text eol=lf
*.asm   text eol=lf
*.md    text eol=lf diff=markdown
*.toml  text eol=lf
*.tsv   text eol=lf
*.sh    text eol=lf
*.java  text eol=lf

# Never to be committed (see .gitignore); marked binary in case one is ever staged
*.bin   binary
*.hex   binary
*.zip   binary
*.obj   binary
*.out   binary
